{
  "name": "fabric-crud-app-template",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "workspaces": [
    "packages/*",
    "instances/*"
  ],
  "description": "A CRUD app template on Microsoft Fabric: entity classes become a SQL database, a GraphQL API and a hosted UI.",
  "license": "MIT",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "predev": "rayfin env --framework vite",
    "prebuild": "rayfin env --framework vite",
    "dev": "rayfin up --exclude-services staticHosting && vite",
    "dev:local": "node scripts/local.mjs && vite",
    "local:db": "node scripts/local.mjs db apply",
    "local:stop": "node scripts/local.mjs --stop",
    "local:purge": "node scripts/local.mjs --purge --yes",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "login": "rayfin login",
    "up": "rayfin up",
    "up:static": "rayfin up staticapp deploy",
    "up:status": "rayfin up status",
    "rayfin:db": "rayfin up list && rayfin up db apply",
    "test": "vitest run",
    "check": "tsc -b && vitest run",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "seed": "node scripts/seed.mjs"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.74.6",
    "@fluentui/react-datepicker-compat": "^0.6.36",
    "@fluentui/react-icons": "^2.0.336",
    "@microsoft/rayfin-auth-provider-fabric": "1.34.0",
    "@microsoft/rayfin-client": "1.34.0",
    "@microsoft/rayfin-core": "1.34.0",
    "@microsoft/rayfin-data": "1.34.0",
    "@tanstack/react-query": "^5.101.4",
    "papaparse": "^5.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@microsoft/rayfin-cli": "1.34.0",
    "@playwright/test": "^1.62.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.8.3",
    "vite": "^7.3.2",
    "vitest": "^4.1.10"
  }
}

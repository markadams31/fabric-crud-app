# Copy to `rayfin/.env`, which is gitignored. Nothing here is a secret, but the
# values are specific to one person's deployment.
#
# `rayfin.yml` interpolates ${VAR} and ${VAR:-default} from this file, so no
# deployment-specific value has to be committed.

# Your deployment's public hosting origin, printed by `rayfin up` on the first
# deploy and shown by `npm run up:status`. The pipeline injects this per
# environment from repo variables (shell env beats this file in the CLI's
# precedence), so no environment's origin is committed. A fresh clone's first
# deploy necessarily runs before this is set — the CLI appends the printed URL
# to rayfin.yml as a literal; move the value here and delete the appended line
# (the ${RAYFIN_HOSTING_URL:-...} placeholder survives).
RAYFIN_HOSTING_URL=https://<your-app>.webapp.fabricapps.net

# `rayfin dev`, `rayfin up` and `rayfin env` also write generated values into rayfin/.env
# (API URL, publishable key, item and workspace IDs). Those are managed by the
# CLI — do not copy them from here.
